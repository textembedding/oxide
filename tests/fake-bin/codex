#!/usr/bin/env python3
"""Model-free Codex fixture for author, internal-review, and merge roles."""

from __future__ import annotations

import json
import re
import subprocess
import sys
from pathlib import Path


class Mcp:
    def __init__(self) -> None:
        harness_python = Path(__file__).resolve().parents[2] / ".venv" / "bin" / "python"
        self.process = subprocess.Popen(
            [str(harness_python), "-m", "swarm_harness.journal_mcp"],
            stdin=subprocess.PIPE,
            stdout=subprocess.PIPE,
            text=True,
        )
        self.number = 0
        self.request("initialize", {"protocolVersion": "2025-06-18"})
        listed = self.request("tools/list", {})
        assert [tool["name"] for tool in listed["tools"]] == [
            "journal_add",
            "journal_search",
        ]

    def request(self, method: str, params: dict) -> dict:
        self.number += 1
        request = {"jsonrpc": "2.0", "id": self.number, "method": method, "params": params}
        assert self.process.stdin is not None and self.process.stdout is not None
        self.process.stdin.write(json.dumps(request) + "\n")
        self.process.stdin.flush()
        response = json.loads(self.process.stdout.readline())
        assert response["id"] == self.number and "error" not in response
        return response["result"]

    def tool(self, name: str, yaml: str) -> str:
        item = {
            "type": "mcp_tool_call",
            "server": "journal",
            "tool": name,
            "arguments": {"yaml": yaml},
            "status": "in_progress",
        }
        print(json.dumps({"type": "item.started", "item": item}), flush=True)
        result = self.request("tools/call", {"name": name, "arguments": {"yaml": yaml}})
        item = {**item, "status": "completed", "result": result}
        print(json.dumps({"type": "item.completed", "item": item}), flush=True)
        if result.get("isError"):
            raise RuntimeError(result)
        return result["content"][0]["text"]

    def close(self) -> None:
        assert self.process.stdin is not None
        self.process.stdin.close()
        if self.process.wait(timeout=5):
            raise RuntimeError("MCP fixture failed")


def git(*arguments: str, check: bool = True) -> str:
    result = subprocess.run(["git", *arguments], text=True, capture_output=True, check=False)
    if check and result.returncode:
        raise RuntimeError(result.stderr)
    return result.stdout.strip()


def block(field_name: str, value: str) -> str:
    return field_name + ": |-\n" + "\n".join("  " + line for line in value.splitlines())


def field(document: str, name: str):
    match = re.search(rf"^\s+{re.escape(name)}: (.+)$", document, re.MULTILINE)
    if match is None:
        return None
    raw = match.group(1)
    try:
        return json.loads(raw)
    except json.JSONDecodeError:
        return raw


def author(mcp: Mcp, item: str, task: str, target_branch: str) -> None:
    branch = str(field(item, "branch"))
    role = str(field(item, "role"))
    git("fetch", "origin")
    main_ref = f"refs/remotes/origin/{target_branch}"
    base = git("rev-parse", main_ref)
    remote_pr = "refs/remotes/origin/swarm-pr"
    git("update-ref", "-d", remote_pr, check=False)
    git("fetch", "origin", f"refs/heads/{branch}:{remote_pr}", check=False)
    if git("rev-parse", "--verify", remote_pr, check=False):
        git("checkout", "-B", "swarm-work", remote_pr)
        if role == "revision":
            git("merge", "--no-edit", main_ref)
    else:
        git("checkout", "-B", "swarm-work", main_ref)

    mcp.tool("journal_add", block("text", f"checkpoint: task:{task}\nfixture edit written"))
    output = Path("toy-output")
    output.mkdir(exist_ok=True)
    if task == "TOY-01":
        (output / "one.txt").write_text("one\n", encoding="utf-8")
    elif task == "TOY-02":
        (output / "two.txt").write_text("two\n", encoding="utf-8")
    elif task == "TOY-03":
        one = (output / "one.txt").read_text(encoding="utf-8").strip()
        two = (output / "two.txt").read_text(encoding="utf-8").strip()
        (output / "combined.txt").write_text(f"{one}\n{two}\n", encoding="utf-8")
    else:
        raise RuntimeError(f"unexpected fixture task: {task}")
    git("add", "toy-output")
    git("commit", "-m", f"Complete {task}")
    git("push", "origin", f"HEAD:refs/heads/{branch}")
    head = git("rev-parse", "HEAD")
    tree = git("rev-parse", "HEAD^{tree}")
    mcp.tool("journal_add", block("text", f"handoff: task:{task}\nchecks passed"))
    mcp.tool(
        "journal_add",
        block(
            "text",
            "\n".join(
                (
                    f"open-pr: task:{task}",
                    f"branch: {branch}",
                    f"base: {base}",
                    f"head: {head}",
                    f"tree: {tree}",
                    "verified: true",
                )
            ),
        ),
    )


def review(mcp: Mcp, item: str, task: str) -> None:
    branch = str(field(item, "branch"))
    head = str(field(item, "head_sha"))
    generation = int(field(item, "generation"))
    ordinal = int(field(item, "review_ordinal"))
    remote_pr = "refs/remotes/origin/swarm-pr"
    git("fetch", "origin", f"refs/heads/{branch}:{remote_pr}")
    if git("rev-parse", remote_pr) != head:
        raise RuntimeError("review fixture observed a different PR head")
    git("checkout", "--detach", head)
    if git("status", "--porcelain=v1", "--untracked-files=all"):
        raise RuntimeError("review clone is dirty")
    mcp.tool(
        "journal_add",
        block(
            "text",
            "\n".join(
                (
                    f"approve: review:{task}:{generation}:{ordinal}",
                    f"head: {head}",
                    "verified: true",
                    "evidence: fixture diff and acceptance check passed",
                )
            ),
        ),
    )


def merge(mcp: Mcp, item: str, task: str) -> None:
    mcp.tool(
        "journal_add",
        block(
            "text",
            "\n".join(
                (
                    f"merge: task:{task}",
                    f"generation: {field(item, 'generation')}",
                    f"head: {field(item, 'head_sha')}",
                )
            ),
        ),
    )


def main() -> int:
    prompt = sys.argv[-1]
    worker = re.search(r"as ([^.]+)\.", prompt).group(1)
    target_branch = re.search(r"origin/([^`]+)`", prompt).group(1)
    mcp = Mcp()
    try:
        item = mcp.tool("journal_search", f"query: worker:{worker}")
        while field(item, "root_task_id") is None:
            ready = mcp.tool("journal_search", "query: queue:ready")
            claim = field(ready, "claim")
            if claim is None:
                return 0
            try:
                mcp.tool("journal_add", f"text: {claim}")
            except RuntimeError:
                item = mcp.tool("journal_search", f"query: worker:{worker}")
                continue
            item = mcp.tool("journal_search", f"query: worker:{worker}")
        task = str(field(item, "root_task_id"))
        role = str(field(item, "role"))
        if role == "revision" or role == "merge":
            mcp.tool("journal_search", f"query: review:{task}:{field(item, 'generation')}")
        elif role.startswith("review:"):
            mcp.tool("journal_search", f"query: {field(item, 'head_sha')}")
        if role in {"author", "revision"}:
            author(mcp, item, task, target_branch)
        elif role.startswith("review:"):
            review(mcp, item, task)
        elif role == "merge":
            merge(mcp, item, task)
        else:
            raise RuntimeError(f"unexpected fixture role: {role}")
        print(
            json.dumps(
                {
                    "type": "item.completed",
                    "item": {"type": "agent_message", "text": f"Finished {role} for {task}."},
                }
            ),
            flush=True,
        )
        return 0
    finally:
        mcp.close()


if __name__ == "__main__":
    raise SystemExit(main())
